{
  "name": "luxora-studio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @luxora/web dev",
    "dev:admin": "pnpm --filter @luxora/admin dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @luxora/web build",
    "build:admin": "pnpm --filter @luxora/admin build",
    "lint": "turbo run lint",
    "db:generate": "dotenv -e .env -- pnpm --filter @luxora/db prisma generate",
    "db:push": "dotenv -e .env -- pnpm --filter @luxora/db prisma db push",
    "db:migrate": "dotenv -e .env -- pnpm --filter @luxora/db prisma migrate dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @luxora/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @luxora/db prisma studio"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
